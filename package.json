{
  "name": "aimed-admin-dashboard",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "prepare": "husky",
    "generate:presets": "tsx src/scripts/generate-theme-presets.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:dependencies && npm run test:upstream",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "test:upstream": "node --test scripts/upstream-check.test.mjs",
    "upstream:check": "node scripts/upstream-check.mjs"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": ["biome check --write --no-errors-on-unmatched"]
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/abstract": "^0.5.3",
    "@dnd-kit/helpers": "^0.5.3",
    "@dnd-kit/react": "^0.5.3",
    "@fullcalendar/react": "^7.1.4",
    "@hookform/resolvers": "^5.9.2",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-table": "^9.3.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "d3-geo": "^3.1.2",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.71.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^4.21.0",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "simple-icons": "^16.37.0",
    "sonner": "^2.0.8",
    "temporal-polyfill": "^1.0.8",
    "topojson-client": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0",
    "@tanstack/react-router": "^1.170.46",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/nunito-sans": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/raleway": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource-variable/merriweather": "^5.3.0",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "@vitejs/plugin-react": "^6.3.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@tailwindcss/vite": "^4.3.5",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0",
    "jsdom": "^31.0.1",
    "shadcn": "^4.23.0",
    "deepmerge": "file:./vendor/deepmerge"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge": "$deepmerge",
    "@ts-morph/common": {
      "minimatch": "11.0.8"
    }
  }
}
